# Anonymous volumes this stack keeps on purpose, one per line: service, path, reason.
# The deployment verification fails on any anonymous volume not listed here, because
# an anonymous volume is never backed up and is replaced by an empty one on down/up.
ssrf_proxy /var/log/squid Squid's access log; nothing to keep across a recreate
ssrf_proxy /var/spool/squid Squid's cache; rebuilt on demand
agent_ssrf_proxy /var/log/squid Squid's access log; nothing to keep across a recreate
agent_ssrf_proxy /var/spool/squid Squid's cache; rebuilt on demand
