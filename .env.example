# Dify + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in the REQUIRED block below before
# `docker compose up`. `.env` is gitignored — never commit real values.
#
# Two halves. The first is this template's own: a handful of prefixed
# variables, every one of them either a secret or the single hostname the
# stack is reached on. The second half is Dify's own configuration file, kept
# as upstream wrote it, because Dify configures these images from an env file
# and reproducing three hundred variables as compose defaults would fork their
# contract and drift from it silently.
#
# Where the compose file owns a variable, the second half says so instead of
# carrying a value. Those are the secrets, which must not ship with a published
# default, and the nine URLs, which this template derives from one hostname.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers the
# version combination this repository has tested.

# ==============================================================================
# REQUIRED — the stack refuses to start until every one of these is set
# ==============================================================================

# Public hostname. Must resolve to this server's public IP for the Let's
# Encrypt TLS-ALPN challenge. Nine of Dify's URLs are derived from it.
DIFY_HOSTNAME=dify.example.com

# Email address for Let's Encrypt renewal notices.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected).
TRAEFIK_HOSTNAME=traefik.dify.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Signs sessions, JWTs and file URLs, and encrypts stored model credentials.
# Losing or changing it logs everyone out and makes stored provider keys
# unreadable. Generate with:
#     openssl rand -base64 42
DIFY_SECRET_KEY=change_me_before_first_start

# Database password. Generate with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 32
DIFY_DB_PASSWORD=change_me_before_first_start

# Redis password. Same command.
DIFY_REDIS_PASSWORD=change_me_before_first_start

# Shared secret between the api and the code sandbox. Both sides read this one
# variable, so they cannot drift apart. Generate with:
#     openssl rand -base64 42
DIFY_SANDBOX_API_KEY=change_me_before_first_start

# Plugin daemon server key. Generate with:
#     openssl rand -base64 42
DIFY_PLUGIN_DAEMON_KEY=change_me_before_first_start

# Shared secret between the api and every plugin. Generate with:
#     openssl rand -base64 42
DIFY_PLUGIN_INNER_API_KEY=change_me_before_first_start

# Bearer token for the agent backend's control-plane API. Upstream ships a
# value with "for-dev-only" in its name; this one has to be yours. Generate:
#     python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
DIFY_AGENT_API_TOKEN=change_me_before_first_start

# Derives the encryption key for agent bearer tokens. This one is not free-form.
# The agent backend refuses to start unless it is unpadded base64url decoding to
# exactly 32 bytes, and says so in a way that costs a deploy to find out. Use:
#     openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
DIFY_AGENT_SERVER_SECRET_KEY=change_me_before_first_start

# Shared secret between the agent backend and the sandbox its commands run in.
# Upstream ships this empty. Generate with:
#     openssl rand -base64 42
DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN=change_me_before_first_start

# Weaviate API key. Upstream publishes one in its compose file; that key is on
# the internet. Generate with:
#     openssl rand -base64 42
DIFY_WEAVIATE_API_KEY=change_me_before_first_start

# ==============================================================================
# OPTIONAL — this template's own knobs, all with working defaults
# ==============================================================================

# The account name Weaviate treats as its admin. Any string.
# DIFY_WEAVIATE_USER=dify@localhost

# Traefik log level: DEBUG, INFO, WARN, ERROR.
# TRAEFIK_LOG_LEVEL=WARN

# How long Traefik waits on a single request. A workflow run is one request and
# Dify allows it an hour, so anything shorter cuts off runs Dify considers fine.
# DIFY_REQUEST_TIMEOUT=3600s

# Database identity. Changing these after the first start needs a new database.
# DIFY_DB_USER=postgres
# DIFY_DB_NAME=dify
# DIFY_DB_PLUGIN_DATABASE=dify_plugin

# Backups (defaults shown; override only to tune).
# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# POSTGRES_BACKUP_PRUNE_DAYS=7
# DATA_BACKUP_PRUNE_DAYS=7
# POSTGRES_BACKUPS_PATH=/srv/dify-postgres/backups
# DATA_BACKUPS_PATH=/srv/dify-application-data/backups
# DATA_PATH=/app/api/storage
# PLUGIN_DATA_PATH=/app/plugin-storage
# POSTGRES_BACKUP_NAME=dify-postgres-backup
# PLUGIN_BACKUP_NAME=dify-plugin-postgres-backup
# DATA_BACKUP_NAME=dify-application-data-backup

# Resource limits. Every service carries memory and CPU limits and reservations
# as compose-level defaults; override any of them here and the override
# survives every git pull. Dify is eighteen containers: on a host with 8 GB the
# defaults fit, and the two that grow under real load are `worker`, which
# indexes documents, and `weaviate`, which holds the embeddings.
# DIFY_API_MEMORY_LIMIT=2g
# DIFY_WORKER_MEMORY_LIMIT=2g
# DIFY_WEB_MEMORY_LIMIT=1g
# DIFY_POSTGRES_MEMORY_LIMIT=2g
# DIFY_REDIS_MEMORY_LIMIT=512m
# DIFY_WEAVIATE_MEMORY_LIMIT=2g
# DIFY_SANDBOX_MEMORY_LIMIT=1g
# DIFY_PLUGIN_DAEMON_MEMORY_LIMIT=1g
# DIFY_AGENT_BACKEND_MEMORY_LIMIT=1g
# DIFY_LOCAL_SANDBOX_MEMORY_LIMIT=1g
# DIFY_NGINX_MEMORY_LIMIT=256m
# TRAEFIK_MEMORY_LIMIT=256m
# DIFY_BACKUPS_MEMORY_LIMIT=512m
# The matching *_CPU_LIMIT, *_MEMORY_RESERVATION and *_CPU_RESERVATION exist
# for each; read them off the compose file.

# How long docker waits for a data-owning service to shut down before SIGKILL.
# DIFY_POSTGRES_STOP_GRACE_PERIOD=60s
# DIFY_REDIS_STOP_GRACE_PERIOD=60s
# DIFY_WEAVIATE_STOP_GRACE_PERIOD=60s

# Image versions. Every image is pinned by digest inside the compose file;
# set the matching variable here to run a different version of that one image
# while every other pin stays as tested. Setting <PREFIX>_IMAGE_TAG replaces
# the whole reference instead. Needs Docker Compose v2.5 or newer (2022).
# The api, web, local-sandbox and agent-backend images are one Dify release:
# move them together or not at all.
# DIFY_API_IMAGE_VERSION=1.17.0
# DIFY_WEB_IMAGE_VERSION=1.17.0
# DIFY_LOCAL_SANDBOX_IMAGE_VERSION=1.17.0
# DIFY_AGENT_BACKEND_IMAGE_VERSION=1.17.0
# DIFY_SANDBOX_IMAGE_VERSION=0.2.15
# DIFY_PLUGIN_DAEMON_IMAGE_VERSION=0.6.10-local
# DIFY_POSTGRES_IMAGE_VERSION=15-alpine
# DIFY_REDIS_IMAGE_VERSION=7.4-alpine
# DIFY_WEAVIATE_IMAGE_VERSION=1.27.0
# DIFY_SQUID_IMAGE_VERSION=6.6-24.04_edge
# DIFY_NGINX_IMAGE_VERSION=1.29
# DIFY_BUSYBOX_IMAGE_VERSION=1.37
# TRAEFIK_IMAGE_VERSION=3.7

# ==============================================================================
# Dify's own configuration file, from the release this template pins.
# Everything below is upstream's, with the variables the compose file owns
# replaced by a line saying what sets them instead.
# ==============================================================================


# ------------------------------------------------------------------
# Essential defaults for Docker Compose deployments.
# Only include variables required for services to start.
# Do not add optional variables to this file.
#
# For a default deployment, copy this file to .env and run:
#   docker compose up -d
#
# Optional and provider-specific variables live under docker/envs/.
# Copy an optional *.env.example file beside itself without the
# .example suffix when you need those advanced settings.
# Values in docker/.env take precedence over docker/envs/*.env files.
# ------------------------------------------------------------------

# Core service URLs
# CONSOLE_API_URL is set by the compose file, from derived from DIFY_HOSTNAME.
# SERVER_CONSOLE_API_URL is set by the compose file, from fixed at http://api:5001, an internal address.
# CONSOLE_WEB_URL is set by the compose file, from derived from DIFY_HOSTNAME.
# SERVICE_API_URL is set by the compose file, from derived from DIFY_HOSTNAME.
# TRIGGER_URL is set by the compose file, from derived from DIFY_HOSTNAME.
# APP_API_URL is set by the compose file, from derived from DIFY_HOSTNAME.
# APP_WEB_URL is set by the compose file, from derived from DIFY_HOSTNAME.
# FILES_URL is set by the compose file, from derived from DIFY_HOSTNAME.
INTERNAL_FILES_URL=
# ENDPOINT_URL_TEMPLATE is set by the compose file, from derived from DIFY_HOSTNAME.
# NEXT_PUBLIC_SOCKET_URL is set by the compose file, from derived from DIFY_HOSTNAME.

# Runtime and security
LANG=C.UTF-8
LC_ALL=C.UTF-8
PYTHONIOENCODING=utf-8
UV_CACHE_DIR=/tmp/.uv-cache
# Leave empty to auto-generate a persistent key in the storage directory.
# SECRET_KEY is set by the compose file, from DIFY_SECRET_KEY.
INIT_PASSWORD=
DEPLOY_ENV=PRODUCTION
CHECK_UPDATE_URL=https://updates.dify.ai
OPENAI_API_BASE=https://api.openai.com/v1
# MIGRATION_ENABLED is set by the compose file, from DIFY_MIGRATION_ENABLED.
FILES_ACCESS_TIMEOUT=300
# Remove `collaboration` from COMPOSE_PROFILES to stop the dedicated websocket service.
ENABLE_COLLABORATION_MODE=true

# Logging and server workers
LOG_LEVEL=INFO
LOG_OUTPUT_FORMAT=text
LOG_FILE=/app/logs/server.log
LOG_FILE_MAX_SIZE=20
LOG_FILE_BACKUP_COUNT=5
# Quoted, unlike upstream: an unquoted value with a space in it is fine for
# compose and a syntax error for anything that reads .env as shell.
LOG_DATEFORMAT="%Y-%m-%d %H:%M:%S"
LOG_TZ=UTC
DEBUG=false
FLASK_DEBUG=false
ENABLE_REQUEST_LOGGING=False
DIFY_BIND_ADDRESS=0.0.0.0
DIFY_PORT=5001
SERVER_WORKER_AMOUNT=1
SERVER_WORKER_CLASS=gevent
SERVER_WORKER_CONNECTIONS=10
API_WEBSOCKET_WORKER_AMOUNT=1
API_WEBSOCKET_WORKER_CLASS=geventwebsocket.gunicorn.workers.GeventWebSocketWorker
API_WEBSOCKET_WORKER_CONNECTIONS=1000
API_WEBSOCKET_GUNICORN_TIMEOUT=360
GUNICORN_TIMEOUT=360
CELERY_WORKER_CLASS=
CELERY_WORKER_AMOUNT=4
CELERY_AUTO_SCALE=false
CELERY_MAX_WORKERS=
CELERY_MIN_WORKERS=
COMPOSE_WORKER_HEALTHCHECK_DISABLED=true
COMPOSE_WORKER_HEALTHCHECK_INTERVAL=30s
COMPOSE_WORKER_HEALTHCHECK_TIMEOUT=30s

# Database
DB_TYPE=postgresql
# DB_USERNAME is set by the compose file, from DIFY_DB_USER.
# DB_PASSWORD is set by the compose file, from DIFY_DB_PASSWORD.
DB_HOST=db_postgres
DB_PORT=5432
# DB_DATABASE is set by the compose file, from DIFY_DB_NAME.
SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=false
SQLALCHEMY_POOL_PRE_PING=false
SQLALCHEMY_POOL_USE_LIFO=false
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_RESET_ON_RETURN=rollback
# PGDATA is set by the compose file, from fixed by the compose file.
# POSTGRES_MAX_CONNECTIONS is set by the compose file, from DIFY_POSTGRES_MAX_CONNECTIONS, passed to the server as a command argument.
# POSTGRES_SHARED_BUFFERS is set by the compose file, from DIFY_POSTGRES_SHARED_BUFFERS, passed to the server as a command argument.
# POSTGRES_WORK_MEM is set by the compose file, from DIFY_POSTGRES_WORK_MEM, passed to the server as a command argument.
# POSTGRES_MAINTENANCE_WORK_MEM is set by the compose file, from DIFY_POSTGRES_MAINTENANCE_WORK_MEM, passed to the server as a command argument.
# POSTGRES_EFFECTIVE_CACHE_SIZE is set by the compose file, from DIFY_POSTGRES_EFFECTIVE_CACHE_SIZE, passed to the server as a command argument.
POSTGRES_STATEMENT_TIMEOUT=0
POSTGRES_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=0

# Redis and Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
# REDIS_PASSWORD is set by the compose file, from DIFY_REDIS_PASSWORD.
REDIS_USE_SSL=false
REDIS_SSL_CERT_REQS=CERT_NONE
REDIS_SSL_CA_CERTS=
REDIS_SSL_CERTFILE=
REDIS_SSL_KEYFILE=
REDIS_DB=0
REDIS_KEY_PREFIX=
REDIS_MAX_CONNECTIONS=
REDIS_RETRY_RETRIES=3
REDIS_RETRY_BACKOFF_BASE=1.0
REDIS_RETRY_BACKOFF_CAP=10.0
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_KEEPALIVE=true
REDIS_KEEPALIVE_IDLE=30
REDIS_KEEPALIVE_INTERVAL=10
REDIS_KEEPALIVE_COUNT=10
# CELERY_BROKER_URL is set by the compose file, from built from DIFY_REDIS_PASSWORD.
CELERY_BACKEND=redis
BROKER_USE_SSL=false
CELERY_TASK_ANNOTATIONS=null
EVENT_BUS_REDIS_URL=
EVENT_BUS_REDIS_CHANNEL_TYPE=pubsub
EVENT_BUS_REDIS_USE_CLUSTERS=false

# Web and app limits
WEB_API_CORS_ALLOW_ORIGINS=*
CONSOLE_CORS_ALLOW_ORIGINS=*
COOKIE_DOMAIN=
NEXT_PUBLIC_COOKIE_DOMAIN=
NEXT_PUBLIC_BATCH_CONCURRENCY=5
API_SENTRY_DSN=
API_SENTRY_TRACES_SAMPLE_RATE=1.0
API_SENTRY_PROFILES_SAMPLE_RATE=1.0
WEB_SENTRY_DSN=
AMPLITUDE_API_KEY=
TURNSTILE_SITE_KEY=
TEXT_GENERATION_TIMEOUT_MS=60000
CSP_WHITELIST=
ALLOW_EMBED=false
ALLOW_UNSAFE_DATA_SCHEME=false
TOP_K_MAX_VALUE=10
INDEXING_MAX_SEGMENTATION_TOKENS_LENGTH=4000
LOOP_NODE_MAX_COUNT=100
MAX_TOOLS_NUM=10
MAX_PARALLEL_LIMIT=10
MAX_ITERATIONS_NUM=99
MAX_TREE_DEPTH=50
ENABLE_WEBSITE_JINAREADER=true
ENABLE_WEBSITE_FIRECRAWL=true
ENABLE_WEBSITE_WATERCRAWL=true
NEXT_PUBLIC_ENABLE_SINGLE_DOLLAR_LATEX=false
NEXT_PUBLIC_ENABLE_AGENT_V2=true
EXPERIMENTAL_ENABLE_VINEXT=false

# Storage and default vector store
STORAGE_TYPE=opendal
OPENDAL_SCHEME=fs
OPENDAL_FS_ROOT=storage
VECTOR_STORE=weaviate
VECTOR_INDEX_NAME_PREFIX=Vector_index
WEAVIATE_ENDPOINT=http://weaviate:8080
# WEAVIATE_API_KEY is set by the compose file, from DIFY_WEAVIATE_API_KEY.
WEAVIATE_GRPC_ENDPOINT=grpc://weaviate:50051
WEAVIATE_TOKENIZATION=word
WEAVIATE_PERSISTENCE_DATA_PATH=/var/lib/weaviate
WEAVIATE_QUERY_DEFAULTS_LIMIT=25
WEAVIATE_AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED=true
WEAVIATE_DEFAULT_VECTORIZER_MODULE=none
WEAVIATE_CLUSTER_HOSTNAME=node1
WEAVIATE_AUTHENTICATION_APIKEY_ENABLED=true
# WEAVIATE_AUTHENTICATION_APIKEY_ALLOWED_KEYS is set by the compose file, from DIFY_WEAVIATE_API_KEY.
# WEAVIATE_AUTHENTICATION_APIKEY_USERS is set by the compose file, from DIFY_WEAVIATE_USER.
WEAVIATE_AUTHORIZATION_ADMINLIST_ENABLED=true
# WEAVIATE_AUTHORIZATION_ADMINLIST_USERS is set by the compose file, from DIFY_WEAVIATE_USER.
WEAVIATE_DISABLE_TELEMETRY=false
WEAVIATE_ENABLE_TOKENIZER_GSE=false
WEAVIATE_ENABLE_TOKENIZER_KAGOME_JA=false
WEAVIATE_ENABLE_TOKENIZER_KAGOME_KR=false

# Sandbox and SSRF proxy
CODE_EXECUTION_ENDPOINT=http://sandbox:8194
# CODE_EXECUTION_API_KEY is set by the compose file, from DIFY_SANDBOX_API_KEY.
CODE_EXECUTION_SSL_VERIFY=True
CODE_EXECUTION_POOL_MAX_CONNECTIONS=100
CODE_EXECUTION_POOL_MAX_KEEPALIVE_CONNECTIONS=20
CODE_EXECUTION_POOL_KEEPALIVE_EXPIRY=5.0
CODE_EXECUTION_CONNECT_TIMEOUT=10
CODE_EXECUTION_READ_TIMEOUT=60
CODE_EXECUTION_WRITE_TIMEOUT=10
# SANDBOX_API_KEY is set by the compose file, from DIFY_SANDBOX_API_KEY.
SANDBOX_GIN_MODE=release
SANDBOX_WORKER_TIMEOUT=15
SANDBOX_ENABLE_NETWORK=true
# SANDBOX_HTTP_PROXY is set by the compose file, from fixed at http://ssrf_proxy:3128.
# SANDBOX_HTTPS_PROXY is set by the compose file, from fixed at http://ssrf_proxy:3128.
SANDBOX_PORT=8194
PIP_MIRROR_URL=
SSRF_PROXY_HTTP_URL=http://ssrf_proxy:3128
SSRF_PROXY_HTTPS_URL=http://ssrf_proxy:3128
SSRF_HTTP_PORT=3128
SSRF_COREDUMP_DIR=/var/spool/squid
SSRF_DEFAULT_TIME_OUT=5
SSRF_DEFAULT_CONNECT_TIME_OUT=5
SSRF_DEFAULT_READ_TIME_OUT=5
SSRF_DEFAULT_WRITE_TIME_OUT=5
SSRF_POOL_MAX_CONNECTIONS=100
SSRF_POOL_MAX_KEEPALIVE_CONNECTIONS=20
SSRF_POOL_KEEPALIVE_EXPIRY=5.0
# Comma-separated CIDR ranges that the SSRF proxy should allow even when they
# resolve to private, loopback, link-local, or otherwise non-public addresses.
# Leave empty (the default) to keep the deny-by-default policy. Required when
# Dify needs to reach internal HTTP endpoints (e.g. an internal API on
# http://172.21.x.x) from an HTTP Request node, a tool, or a plugin.
# Example: SSRF_PROXY_ALLOW_PRIVATE_IPS=172.21.0.0/16,10.0.0.0/8
SSRF_PROXY_ALLOW_PRIVATE_IPS=

# Plugin daemon
# DB_PLUGIN_DATABASE is set by the compose file, from DIFY_DB_PLUGIN_DATABASE.
# EXPOSE_PLUGIN_DAEMON_PORT is set by the compose file, from nothing: the plugin daemon is reached over the internal network.
PLUGIN_DAEMON_PORT=5002
# PLUGIN_DAEMON_KEY is set by the compose file, from DIFY_PLUGIN_DAEMON_KEY.
PLUGIN_DAEMON_URL=http://plugin_daemon:5002
PLUGIN_MAX_PACKAGE_SIZE=52428800
PLUGIN_MAX_FILE_SIZE=52428800
PLUGIN_MODEL_SCHEMA_CACHE_TTL=3600
PLUGIN_PPROF_ENABLED=false
PLUGIN_DEBUGGING_HOST=0.0.0.0
PLUGIN_DEBUGGING_PORT=5003
EXPOSE_PLUGIN_DEBUGGING_HOST=localhost
# EXPOSE_PLUGIN_DEBUGGING_PORT is set by the compose file, from nothing: the plugin debugging port is not published here.
# PLUGIN_DIFY_INNER_API_KEY is set by the compose file, from DIFY_PLUGIN_INNER_API_KEY.
PLUGIN_DIFY_INNER_API_URL=http://api:5001
FORCE_VERIFYING_SIGNATURE=true
PLUGIN_STDIO_BUFFER_SIZE=1024
PLUGIN_STDIO_MAX_BUFFER_SIZE=5242880
PLUGIN_PYTHON_ENV_INIT_TIMEOUT=120
PLUGIN_MAX_EXECUTION_TIMEOUT=600
PLUGIN_STORAGE_TYPE=local
PLUGIN_STORAGE_LOCAL_ROOT=/app/storage
PLUGIN_WORKING_PATH=/app/storage/cwd
PLUGIN_INSTALLED_PATH=plugin
PLUGIN_PACKAGE_CACHE_PATH=plugin_packages
PLUGIN_MEDIA_CACHE_PATH=assets
PLUGIN_STORAGE_OSS_BUCKET=
PLUGIN_SENTRY_ENABLED=false
PLUGIN_SENTRY_DSN=
MARKETPLACE_ENABLED=true
MARKETPLACE_API_URL=https://marketplace.dify.ai
MARKETPLACE_URL=

# Dify Agent backend
# AGENT_BACKEND_BASE_URL is set by the compose file, from fixed at http://agent_backend:5050.
# Bearer token for the Agent backend control-plane API.
# Replace this development default in production.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# DIFY_AGENT_API_TOKEN is set by the compose file, from DIFY_AGENT_API_TOKEN, read by the compose file.
# Leave empty to derive from REDIS_PASSWORD.
DIFY_AGENT_REDIS_URL=
# Leave empty to derive from PLUGIN_DAEMON_URL and PLUGIN_DAEMON_KEY.
DIFY_AGENT_PLUGIN_DAEMON_URL=
DIFY_AGENT_PLUGIN_DAEMON_API_KEY=
# Leave empty to derive from PLUGIN_DIFY_INNER_API_URL and PLUGIN_DIFY_INNER_API_KEY.
# DIFY_AGENT_INNER_API_KEY must match API/worker INNER_API_KEY_FOR_PLUGIN, not INNER_API_KEY.
DIFY_AGENT_INNER_API_URL=
DIFY_AGENT_INNER_API_KEY=
# Select exactly one coherent Home Snapshot + Sandbox backend.
DIFY_AGENT_RUNTIME_BACKEND=local
DIFY_AGENT_LOCAL_SANDBOX_ENDPOINT=http://local_sandbox:5004
# DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN is set by the compose file, from DIFY_AGENT_LOCAL_SANDBOX_AUTH_TOKEN, read by the compose file.
# Sandbox-reachable Dify API base for dify-agent CLI /files/* transfers.
# Remote Sandboxes should use the public Dify ingress; local Compose uses api via agent_ssrf_proxy.
DIFY_AGENT_SANDBOX_FILES_BASE_URL=http://api:5001
DIFY_AGENT_STUB_API_BASE_URL=http://agent_backend:5050/agent-stub
# This is security-sensitive: it derives the JWE encryption key for Agent Stub bearer tokens.
# Replace this development default in production.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# DIFY_AGENT_SERVER_SECRET_KEY is set by the compose file, from DIFY_AGENT_SERVER_SECRET_KEY, read by the compose file.

# Nginx and Docker Compose
# NGINX_SERVER_NAME is set by the compose file, from the compose file, which puts Traefik in front of nginx.
# NGINX_HTTPS_ENABLED is set by the compose file, from the compose file, which puts Traefik in front of nginx.
# NGINX_PORT is set by the compose file, from the compose file, which puts Traefik in front of nginx.
# NGINX_SSL_PORT is set by the compose file, from the compose file, which puts Traefik in front of nginx.
# NGINX_SSL_CERT_FILENAME is set by the compose file, from the compose file, which puts Traefik in front of nginx.
# NGINX_SSL_CERT_KEY_FILENAME is set by the compose file, from the compose file, which puts Traefik in front of nginx.
# NGINX_SSL_PROTOCOLS is set by the compose file, from the compose file, which puts Traefik in front of nginx.
# NGINX_WORKER_PROCESSES is set by the compose file, from DIFY_NGINX_WORKER_PROCESSES.
# NGINX_CLIENT_MAX_BODY_SIZE is set by the compose file, from DIFY_NGINX_CLIENT_MAX_BODY_SIZE.
# NGINX_KEEPALIVE_TIMEOUT is set by the compose file, from DIFY_NGINX_KEEPALIVE_TIMEOUT.
# NGINX_PROXY_READ_TIMEOUT is set by the compose file, from DIFY_NGINX_PROXY_READ_TIMEOUT.
# NGINX_PROXY_SEND_TIMEOUT is set by the compose file, from DIFY_NGINX_PROXY_SEND_TIMEOUT.
# NGINX_ENABLE_CERTBOT_CHALLENGE is set by the compose file, from the compose file, which puts Traefik in front of nginx.
# NGINX_SOCKET_IO_UPSTREAM is set by the compose file, from the compose file, which puts Traefik in front of nginx.
# EXPOSE_NGINX_PORT is set by the compose file, from the compose file, which puts Traefik in front of nginx.
# EXPOSE_NGINX_SSL_PORT is set by the compose file, from the compose file, which puts Traefik in front of nginx.
# COMPOSE_PROFILES is set by the compose file, from nothing: this template has no profiles, every service it needs always starts.
